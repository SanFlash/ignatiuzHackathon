# The only required value for AI questions and answer evaluation:
OPENAI_API_KEY=
# Optional; defaults to this model when blank.
OPENAI_MODEL=gpt-4o-mini
# Local storage requires no database account. Data resets on restart.
DATABASE_MODE=demo
SECRET_KEY=change-me
RECRUITER_PASSWORD=
COOKIE_SECURE=false
# Optional persistence; set DATABASE_MODE=supabase to enable.
SUPABASE_URL=
SUPABASE_KEY=
